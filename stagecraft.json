    },
    {
      "route": "FaceFusion 3.9.1",
      "displayed_model": "hyperswap_1a_256",
      "state": "repair_experiments_executed",
      "lesson": "Repairs can change freckles, gaze and expression; not automatically production accepted"
    },
    {
      "route": "FaceFusion expression restoration",
      "displayed_model": "live_portrait",
      "state": "51_frame_experiment_completed",
      "lesson": "Measure expression and temporal continuity against original footage"
    },
    {
      "route": "Local deterministic compositing",
      "displayed_model": "original-eye pixels with tracked mask",
      "state": "51_frame_experiment_completed",
      "lesson": "Keep original pixel and encoded-output claims separate; inspect tracking warning intervals"
    },
    {
      "route": "ComfyUI H3",
      "displayed_model": "MiniMax H3 INT8 reference-to-video graph",
      "state": "setup_validated_not_sampled",
      "lesson": "Resource headroom guard stopped before sampling; no generated output or observed model OOM"
    },
    {
      "route": "Topaz Video 1.7.1.0",
      "displayed_model": "Starlight Precise 2.6",
      "state": "installed_device_enumerated_no_render",
      "lesson": "Setup is not an enhancement result; Starlight Fast was not used"
    },
    {
      "route": "Adobe Firefly",
      "displayed_model": "Veo 3.1 Fast",
      "state": "attempt_failed_no_output",
      "lesson": "Do not count a submitted or failed job as produced footage"
    },
    {
      "route": "faster-whisper 1.2.1",
      "displayed_model": "small.en and base.en CPU INT8",
      "state": "diagnostic_transcription",
      "lesson": "ASR is approximate evidence, not authoritative lyrics or phoneme timing"
    }
  ],
