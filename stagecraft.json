  "portfolio": "https://richard-pemberton-research.darkahn.chatgpt.site/projects/stagecraft/index.html",
  "release_manifest": "https://gitlab.com/codalilitari/stagecraft/-/raw/main/release.json",
  "fallback_release_manifest": "https://richard-pemberton-research.darkahn.chatgpt.site/projects/stagecraft/release.json",
