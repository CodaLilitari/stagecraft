  "authorship": {
    "project_direction_and_example_materials": [
      "Andrei",
      "Lilitari / Lily"
    ],
    "workflow_engineering_and_verification": "Coda in Codex"
  },
  "requirements": {
    "helper_python_minimum": "3.11",
    "python_tested": "3.13.15",
    "ffmpeg_ffprobe_tested": "7.0.2",
    "operating_system_tested": "Windows",
    "python_third_party_packages_required": false,
    "sampler_requires_ffmpeg_and_ffprobe": true,
    "provider_accounts_included": false,
    "paid_api_required_for_offline_helpers": false
  },
  "workflow": [
    "Recover the authoritative recording, brief, cut, ownership and holds",
    "Establish resource limits and explicitly authorized Goal/checkpoints",
    "Map the actual audio and supplied lyrics; distinguish provisional timing",
    "Separate canonical identity from wardrobe and scene design",
    "Pilot singing, dance energy, identity, light and camera movement together",
    "Generate through verified host-specific capabilities and record pending jobs",
    "Inspect one-second samples, dense defect spans and actual audiovisual playback",
    "Preserve original sources and selected soundtrack during conform/editing",
    "Validate native frames, audio, save/reopen and editable delivery",
    "Record completed, sampled, user-approved and unperformed checks separately"
  ],
  "helpers": [
    {
      "path": "scripts/sample_video.py",
      "purpose": "Timestamp-aware PNG/HTML sampling and optional reported decode-error checks",
      "cannot_prove": [
        "continuous motion",
        "lip sync",
        "perceptual approval"
      ]
    },
    {
      "path": "scripts/conform_audit.py",
      "purpose": "Manifest timing, coverage, rational rates, bounds and optional hashes",
      "cannot_prove": [
        "native import correctness",
        "actual media durations without independent probing",
        "visual quality"
      ]
    },
    {
      "path": "scripts/check_updates.py",
      "purpose": "Read-only release metadata comparison",
      "cannot_prove": [
        "release authenticity",
        "archive availability",
        "archive byte equality"
      ],
      "downloads_or_installs_code": false
    }
  ],
  "model_observations": [
    {
      "route": "Google Flow",
      "displayed_model": "Omni 1.1 Flash",
      "state": "rendered_and_reviewed",
      "lesson": "Canonical facial drift and weak performance energy despite usable narrative/comedy material; not a universal model ranking"
    },
    {
      "route": "Adobe Firefly",
      "displayed_model": "Kling 3.0 Omni",
      "state": "rendered_and_reviewed",
      "lesson": "Stronger multi-shot performance; actor role and phrase timing still need inspection"
    },
    {
      "route": "Direct Kling",
      "displayed_model": "VIDEO 3.0 Omni",
